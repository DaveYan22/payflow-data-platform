# Copy this file to .env and fill in your own values. Never commit .env.

# --- MySQL (OLTP source: core_banking_prod, MySQL80 service on the Windows host) ---
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=core_banking_prod
MYSQL_USER=banking_user
MYSQL_PASSWORD=change_me

# --- MySQL admin login used from Windows by source_data/data_generator.py and notebooks ---
MYSQL_LOCAL_HOST=localhost
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change_me

# --- ClickHouse (OLAP warehouse) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_BRONZE_DB=bronze

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# --- Superset ---
SUPERSET_SECRET_KEY=change_me_to_a_long_random_string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me

# --- Paths inside the Airflow container ---
RISK_TIERS_PATH=/opt/airflow/source_data/country_risk_tiers.xlsx
DBT_PROJECT_DIR=/opt/airflow/dbt_transform
